<!DOCTYPE html>
<html lang="en" class="h-full" data-theme="corporate">
  <head>
    <title><%= content_for(:title) || "Vae" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <script>
      (() => {
        try {
          const root = document.documentElement;
          const saved = localStorage.getItem("theme");
          const prefersDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
          if (saved === "dark" || (!saved && prefersDark)) {
            root.classList.add("dark");
            root.dataset.theme = "business";
          } else {
            root.dataset.theme = "corporate";
          }
        } catch (_) {
          // no-op when localStorage is unavailable
        }
      })();
    </script>
  </head>

  <body class="min-h-screen bg-gradient-to-br from-base-200 via-base-100 to-base-200 text-base-content font-sans antialiased">
    <div class="min-h-screen flex flex-col">
      <!-- Enhanced Header with Glassmorphism Effect -->
      <header class="sticky top-0 z-50 backdrop-blur-lg bg-base-100/80 border-b border-base-300/50 shadow-lg">
        <div class="navbar max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2">
          <div class="navbar-start gap-4">
            <%= link_to root_path, class: "flex items-center gap-3 btn btn-ghost normal-case hover:scale-105 transition-transform duration-200" do %>
              <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-primary to-secondary flex items-center justify-center shadow-lg">
                <span class="text-xl font-bold text-primary-content">V</span>
              </div>
              <span class="text-2xl font-display font-bold bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">
                Vae
              </span>
            <% end %>
            <span class="badge badge-primary badge-outline hidden sm:inline-flex gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
              </svg>
              Curated marketplace
            </span>
          </div>
          <div class="navbar-center hidden md:flex">
            <ul class="menu menu-horizontal px-1 gap-1">
              <li>
                <%= link_to ads_path, class: "hover:bg-primary/10 hover:text-primary rounded-lg transition-colors" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                  </svg>
                  All Ads
                <% end %>
              </li>
              <% if logged_in? %>
                <li>
                  <%= link_to ads_path(anchor: "mine"), class: "hover:bg-primary/10 hover:text-primary rounded-lg transition-colors" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                    My Ads
                  <% end %>
                </li>
              <% end %>
            </ul>
          </div>
          <div class="navbar-end gap-2 flex-nowrap">
            <button type="button"
                    class="btn btn-ghost btn-sm gap-2 hover:bg-base-200 rounded-lg transition-all"
                    data-controller="dark-mode"
                    data-action="click->dark-mode#toggle"
                    title="Toggle theme">
              <span class="inline-flex" data-dark-mode-target="icon"></span>
              <span class="hidden sm:inline">Theme</span>
            </button>
            <% if logged_in? %>
              <div class="hidden lg:flex items-center gap-2 px-3 py-1 bg-base-200/50 rounded-lg">
                <div class="avatar placeholder">
                  <div class="bg-primary text-primary-content rounded-full w-6 h-6">
                    <span class="text-xs"><%= current_user.email[0].upcase %></span>
                  </div>
                </div>
                <span class="text-sm text-base-content/70 max-w-[150px] truncate"><%= current_user.email %></span>
              </div>
              <%= link_to new_ad_path, class: "btn btn-primary btn-sm gap-2 shadow-lg hover:shadow-xl transition-shadow" do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                New Ad
              <% end %>
              <%= button_to session_path, method: :delete,
                    class: "btn btn-ghost btn-sm hover:bg-error/10 hover:text-error transition-colors",
                    form: { class: "inline" } do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                </svg>
                <span class="hidden xl:inline">Logout</span>
              <% end %>
            <% else %>
              <%= link_to "Sign in", new_session_path, class: "btn btn-ghost btn-sm hover:bg-base-200 rounded-lg transition-colors" %>
              <%= link_to new_users_registration_path, class: "btn btn-primary btn-sm gap-2 shadow-lg hover:shadow-xl transition-shadow" do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                </svg>
                Sign up
              <% end %>
            <% end %>
          </div>
        </div>
      </header>

      <!-- Enhanced Flash Messages -->
      <% if flash.any? %>
        <section class="max-w-4xl w-full mx-auto px-4 sm:px-6 lg:px-8 mt-6 animate-fade-in">
          <% flash.each do |type, message| %>
            <%
              is_notice = type.to_s == "notice"
              alert_class = is_notice ? "alert-success" : "alert-error"
              icon_path = is_notice ?
                "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" :
                "M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
            %>
            <div class="alert <%= alert_class %> shadow-xl mb-4 rounded-2xl border-2 <%= is_notice ? 'border-success/20' : 'border-error/20' %>">
              <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= icon_path %>" />
              </svg>
              <div class="flex-1">
                <h3 class="font-semibold text-base"><%= type.to_s.titleize %></h3>
                <div class="text-sm opacity-90"><%= message %></div>
              </div>
            </div>
          <% end %>
        </section>
      <% end %>

      <!-- Main Content Area -->
      <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <%= yield %>
      </main>

      <!-- Enhanced Footer -->
      <footer class="bg-base-100/90 backdrop-blur-sm border-t border-base-300/50 mt-auto">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Brand Section -->
            <div class="space-y-4">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-primary to-secondary flex items-center justify-center shadow-lg">
                  <span class="text-xl font-bold text-primary-content">V</span>
                </div>
                <span class="text-xl font-display font-bold bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">
                  Vae
                </span>
              </div>
              <p class="text-sm text-base-content/70 leading-relaxed">
                A curated marketplace for buying and selling unique items. Join our community today.
              </p>
            </div>

            <!-- Quick Links -->
            <div class="space-y-4">
              <h3 class="font-semibold text-base-content">Quick Links</h3>
              <ul class="space-y-2 text-sm">
                <li>
                  <%= link_to ads_path, class: "flex items-center gap-2 text-base-content/70 hover:text-primary transition-colors group" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                    Browse All Ads
                  <% end %>
                </li>
                <% if logged_in? %>
                  <li>
                    <%= link_to new_ad_path, class: "flex items-center gap-2 text-base-content/70 hover:text-primary transition-colors group" do %>
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                      </svg>
                      Create New Ad
                    <% end %>
                  </li>
                <% else %>
                  <li>
                    <%= link_to new_users_registration_path, class: "flex items-center gap-2 text-base-content/70 hover:text-primary transition-colors group" do %>
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                      </svg>
                      Join Our Community
                    <% end %>
                  </li>
                <% end %>
              </ul>
            </div>

            <!-- Tech Stack -->
            <div class="space-y-4">
              <h3 class="font-semibold text-base-content">Built With</h3>
              <div class="flex flex-wrap gap-2">
                <span class="badge badge-outline gap-1">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                  Rails 8
                </span>
                <a href="https://tailwindcss.com/" target="_blank" rel="noopener" class="badge badge-outline hover:badge-primary transition-colors">
                  Tailwind CSS
                </a>
                <a href="https://daisyui.com/" target="_blank" rel="noopener" class="badge badge-outline hover:badge-primary transition-colors">
                  daisyUI
                </a>
                <span class="badge badge-outline gap-1">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                  </svg>
                  Hotwire
                </span>
              </div>
            </div>
          </div>

          <!-- Bottom Bar -->
          <div class="mt-8 pt-6 border-t border-base-300/50 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-base-content/60">
            <p class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              &copy; <%= Time.current.year %> Vae Marketplace. All rights reserved.
            </p>
            <p class="text-xs">
              Made with
              <span class="text-error inline-block animate-pulse">❤</span>
              using Ruby on Rails
            </p>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
